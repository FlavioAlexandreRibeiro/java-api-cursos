								{
									"key": "id",
									"value": "1"
								}
							]
						},
						"description": "Busca um professor específico pelo seu ID"
					},
					"response": []
				},
				{
					"name": "Atualizar Professor",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"João Silva Atualizado\",\n    \"email\": \"joao.silva.atualizado@email.com\",\n    \"telefone\": \"11988888888\",\n    \"especialidade\": \"Java e Spring Boot\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/professores/:id",
							"host": ["{{baseUrl}}"],
							"path": ["professores", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "1"
								}
							]
						},
						"description": "Atualiza os dados de um professor existente"
					},
					"response": []
				},
				{
					"name": "Deletar Professor",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/professores/:id",
							"host": ["{{baseUrl}}"],
							"path": ["professores", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "1"
								}
							]
						},
						"description": "Deleta um professor pelo ID (também deleta todos os cursos associados)"
					},
					"response": []
				}
			]
		},
