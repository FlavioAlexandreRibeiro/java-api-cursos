{
	"info": {
		"_postman_id": "api-cursos-collection",
		"name": "API de Cursos",
		"description": "Collection para testar a API de Cursos - Sistema de gerenciamento de cursos e professores",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
