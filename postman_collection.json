			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Professores",
			"item": [
				{
					"name": "Criar Professor",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"João Silva\",\n    \"email\": \"joao.silva@email.com\",\n    \"telefone\": \"11999999999\",\n    \"especialidade\": \"Java\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/professores",
							"host": ["{{baseUrl}}"],
							"path": ["professores"]
						},
						"description": "Cria um novo professor no sistema"
					},
					"response": []
				},
				{
					"name": "Buscar Todos os Professores",
					"request": {
						"method": "GET",
						"header": [],
