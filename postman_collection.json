									"disabled": true
								},
								{
									"key": "especialidade",
									"value": "",
									"disabled": true
								}
							]
						},
						"description": "Busca todos os professores com filtros opcionais e paginação"
					},
					"response": []
				},
				{
					"name": "Buscar Professor por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/professores/:id",
							"host": ["{{baseUrl}}"],
							"path": ["professores", ":id"],
